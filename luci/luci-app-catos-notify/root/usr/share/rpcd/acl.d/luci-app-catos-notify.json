{
  "luci-app-catos-notify": {
    "description": "Manage CatOS Notify settings and send notifications",
    "read": {
      "uci": ["catos_notify"],
      "ubus": {
        "catos.notify": ["status"]
      }
    },
    "write": {
      "uci": ["catos_notify"],
      "ubus": {
        "catos.notify": ["send", "publish", "test", "token"]
      }
    }
  }
}
