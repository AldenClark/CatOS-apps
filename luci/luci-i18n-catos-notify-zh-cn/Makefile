include $(TOPDIR)/rules.mk

PKG_NAME:=luci-i18n-catos-notify-zh-cn
PKG_VERSION:=0.2.0
PKG_RELEASE:=3
PKG_LICENSE:=MIT
PKG_BUILD_DEPENDS:=luci-base/host

include $(INCLUDE_DIR)/package.mk

# gh-action-sdk builds each name in PACKAGES through package/<name>/compile.
# Use an actual feed package directory for the translation rather than relying
# on the child package generated by luci.mk in luci-app-catos-notify.
define Package/luci-i18n-catos-notify-zh-cn
  SECTION:=luci
  CATEGORY:=LuCI
  TITLE:=CatOS Notify Simplified Chinese translation
  URL:=https://github.com/AldenClark/CatOS-apps
  PKGARCH:=all
  DEPENDS:=+luci-app-catos-notify
endef

define Build/Compile
endef

define Package/luci-i18n-catos-notify-zh-cn/install
	$(INSTALL_DIR) $(1)/usr/lib/lua/luci/i18n $(1)/etc/uci-defaults
	po2lmo ./po/zh_Hans/catos-notify.po $(1)/usr/lib/lua/luci/i18n/catos-notify.zh-cn.lmo
	printf '%s\n' "uci set luci.languages.zh_cn='简体中文 (Simplified Chinese)'; uci commit luci" \
		> $(1)/etc/uci-defaults/luci-i18n-catos-notify-zh-cn
	chmod 0755 $(1)/etc/uci-defaults/luci-i18n-catos-notify-zh-cn
endef

$(eval $(call BuildPackage,luci-i18n-catos-notify-zh-cn))
