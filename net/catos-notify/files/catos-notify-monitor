#!/bin/sh
# Periodic state sampling; procd supervises this process.
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
. /usr/share/libubox/jshn.sh

RUN=${CATOS_NOTIFY_RUN:-/tmp/catos-notify}
STATE="$RUN/state"
mkdir -p "$STATE" || exit 1

setting() {
	uci -q get "catos_notify.main.$1" 2>/dev/null || printf '%s' "$2"
}

number_or() {
	case "$1" in ''|*[!0-9]*) printf '%s' "$2" ;; *) printf '%s' "$1" ;; esac
}

sections() {
	uci -q show catos_notify 2>/dev/null |
		sed -n "s/^catos_notify\.\([^=]*\)=$1$/\1/p"
}

field() {
	uci -q get "catos_notify.$1.$2" 2>/dev/null || true
}

json_value() {
	printf '%s' "$1" | jsonfilter -e "$2" 2>/dev/null | head -n 1
}

address_list() {
	local raw="$1" kind="$2" addresses masks addr mask result=''
	addresses="$(printf '%s' "$raw" | jsonfilter -e "@[\"$kind\"][*].address" 2>/dev/null)"
	masks="$(printf '%s' "$raw" | jsonfilter -e "@[\"$kind\"][*].mask" 2>/dev/null)"
	set -- $masks
	for addr in $addresses; do
		[ "$#" -gt 0 ] || break
		mask="$1"
		shift
		result="$result
$addr/$mask"
	done
	printf '%s\n' "$result" | sed '/^$/d' | sort -u | tr '\n' ',' | sed 's/,$//'
}

emit() {
	local event="$1" body="$2" interface="$3" old="$4" new="$5" severity="${6:-normal}" device="${7:-}"
	json_init
	json_add_string source system
	json_add_string event "$event"
	json_add_string body "$body"
	json_add_string severity "$severity"
	json_add_string interface "$interface"
	json_add_string device "$device"
	json_add_string old "$old"
	json_add_string new "$new"
	json_add_string timestamp "$(date -Iseconds)"
	json_add_object data
	json_add_string interface "$interface"
	json_add_string old "$old"
	json_add_string new "$new"
	json_close_object
	json_dump | /usr/bin/catos-notify publish >/dev/null 2>&1 || true
}

change() {
	local key="$1" value="$2" event="$3" label="$4" interface="$5" severity="$6"
	local old
	old="$(cat "$STATE/$key" 2>/dev/null)"
	if [ ! -f "$STATE/$key" ]; then
		printf '%s' "$value" > "$STATE/$key"
		return
	fi
	[ "$old" = "$value" ] && return
	printf '%s' "$value" > "$STATE/$key"
	emit "$event" "$label: ${old:--} -> ${value:--}" "$interface" "$old" "$value" "$severity"
}

wan_poll() {
	local iface raw up ipv4 ipv6 prefix prev
	for iface in $(setting wan_interfaces 'wan wan6'); do
		case "$iface" in *[!a-zA-Z0-9_-]*|'') continue ;; esac
		raw="$(ubus -S call "network.interface.$iface" status 2>/dev/null)" || continue
		up="$(json_value "$raw" '@.up')"
		case "$up" in true) up=1 ;; *) up=0 ;; esac
		if [ -f "$STATE/wan-$iface-up" ]; then
			prev="$(cat "$STATE/wan-$iface-up")"
			if [ "$prev" != "$up" ]; then
				if [ "$up" = 1 ]; then
					emit wan.up "WAN $iface has recovered" "$iface" "$prev" "$up" normal
				else
					emit wan.down "WAN $iface disconnected" "$iface" "$prev" "$up" high
				fi
			fi
		fi
		printf '%s' "$up" > "$STATE/wan-$iface-up"
		[ "$up" = 1 ] || continue
		ipv4="$(address_list "$raw" ipv4-address)"
		ipv6="$(address_list "$raw" ipv6-address)"
		prefix="$(address_list "$raw" ipv6-prefix)"
		# For dual-stack interfaces, both WAN IPv4 and delegated IPv6 are sampled.
		change "wan-$iface-ipv4" "$ipv4" wan.ipv4.changed "WAN IPv4 ($iface)" "$iface" normal
		change "wan-$iface-ipv6" "$ipv6" wan.ipv6.changed "WAN IPv6 ($iface)" "$iface" normal
		change "wan-$iface-prefix" "$prefix" wan.prefix.changed "Delegated prefix ($iface)" "$iface" normal
	done
}

public_ipv4() {
	local result
	result="$(curl -4fsS --connect-timeout 4 --max-time 8 https://api.ipify.org 2>/dev/null)" ||
		result="$(curl -4fsS --connect-timeout 4 --max-time 8 https://ipv4.icanhazip.com 2>/dev/null)" || return
	result="$(printf '%s' "$result" | tr -d '\r\n')"
	case "$result" in ''|*[!0-9.]*|127.*|10.*|192.168.*|169.254.*|0.*) return ;; esac
	# IPv4 range validation and RFC1918/CGNAT rejection.
	printf '%s' "$result" | awk -F. '
		NF != 4 { exit 1 }
		{ for(i=1;i<=4;i++) if($i !~ /^[0-9]+$/ || $i+0>255) exit 1;
		  if($1+0>=224 || $1+0==0) exit 1;
		  if($1+0==172 && $2+0>=16 && $2+0<=31) exit 1;
		  if($1+0==100 && $2+0>=64 && $2+0<=127) exit 1;
		  exit 0 }' || return
	change public-ipv4 "$result" public.ipv4.changed 'Public IPv4' '' normal
}

public_ipv6() {
	local result
	result="$(curl -6fsS --connect-timeout 4 --max-time 8 https://api6.ipify.org 2>/dev/null)" ||
		result="$(curl -6fsS --connect-timeout 4 --max-time 8 https://ipv6.icanhazip.com 2>/dev/null)" || return
	result="$(printf '%s' "$result" | tr -d '\r\n')"
	case "$result" in *:*) ;; *) return ;; esac
	case "$result" in *[!a-fA-F0-9:]*|''|fe80:*|fc*|fd*|::1) return ;; esac
	change public-ipv6 "$result" public.ipv6.changed 'Public IPv6' '' normal
}

primary_poll() {
	local defaults count primary
	defaults="$(ip -4 route show default 2>/dev/null)"
	[ -n "$defaults" ] || return
	count="$(printf '%s\n' "$defaults" | wc -l)"
	[ "$count" -eq 1 ] || return # No unique default in ECMP/load-balanced modes.
	primary="$(printf '%s\n' "$defaults" | awk '{
		for(i=1;i<=NF;i++) if($i=="dev") dev=$(i+1);
		if(dev!="") print dev
	}')"
	[ -n "$primary" ] || return
	change wan-primary "$primary" wan.primary.changed 'Primary WAN interface' '' normal
}

known_mac() {
	local section mac
	for section in $(sections device); do
		mac="$(field "$section" mac | tr 'A-F' 'a-f')"
		[ "$mac" = "$1" ] && return 0
	done
	return 1
}

unknown_devices_poll() {
	[ "$(setting discover_devices 1)" = 1 ] || return
	local iface="$(setting device_interface br-lan)" mac seen
	case "$iface" in *[!a-zA-Z0-9._-]*|'') return ;; esac
	[ -e "$STATE/seen-macs" ] || : > "$STATE/seen-macs"
	{
		ip neigh show dev "$iface" 2>/dev/null |
			awk '{
				for(i=1;i<=NF;i++)
					if($i=="lladdr") print tolower($(i+1));
			}'
		[ ! -r /tmp/dhcp.leases ] || awk '{print tolower($2)}' /tmp/dhcp.leases
	} | sort -u | while IFS= read -r mac; do
			case "$mac" in
				??:??:??:??:??:??) ;;
				*) continue ;;
			esac
			known_mac "$mac" && continue
			grep -Fqx "$mac" "$STATE/seen-macs" 2>/dev/null && continue
			[ "$(wc -l < "$STATE/seen-macs")" -lt 256 ] || continue
			# Do not alarm on the first baseline scan after boot.
			if [ -f "$STATE/discovery-ready" ]; then
				emit device.unknown.online "Unknown device detected: $mac" "$iface" '' "$mac" high "$mac"
			fi
			printf '%s\n' "$mac" >> "$STATE/seen-macs"
		done
	: > "$STATE/discovery-ready"
}

probe_device() {
	local section="$1" addr mac name key status last pending count
	[ "$(field "$section" monitor)" = 1 ] || return
	addr="$(field "$section" ip)"
	mac="$(field "$section" mac)"
	name="$(field "$section" name)"
	[ -n "$addr" ] || return
	case "$addr" in -*|*[!a-zA-Z0-9:.]*) return ;; esac
	key="$(printf '%s' "$section" | tr -cd 'a-zA-Z0-9_-')"
	[ -n "$key" ] || return
	if ping -c 1 -W 1 "$addr" >/dev/null 2>&1; then status=online; else status=offline; fi
	last="$(cat "$STATE/device-$key" 2>/dev/null)"
	if [ -z "$last" ]; then
		printf '%s' "$status" > "$STATE/device-$key"
		return
	fi
	[ "$status" != "$last" ] || { rm -f "$STATE/device-$key-pending"; return; }
	pending="$(cat "$STATE/device-$key-pending" 2>/dev/null)"
	if [ "$pending" != "$status" ]; then
		printf '%s' "$status" > "$STATE/device-$key-pending"
		return
	fi
	printf '%s' "$status" > "$STATE/device-$key"
	rm -f "$STATE/device-$key-pending"
	if [ "$status" = online ]; then
		emit device.known.online "Device ${name:-$mac} ($addr) is online" '' offline online normal "$mac"
	else
		emit device.known.offline "Device ${name:-$mac} ($addr) is offline" '' online offline high "$mac"
	fi
}

known_devices_poll() {
	local section
	for section in $(sections device); do probe_device "$section"; done
}

auth_log_poll() {
	local window max now cutoff type key count
	window="$(number_or "$(setting auth_window 600)" 600)"
	max="$(number_or "$(setting auth_failures 5)" 5)"
	[ "$window" -ge 30 ] && [ "$window" -le 86400 ] || window=600
	[ "$max" -ge 2 ] && [ "$max" -le 100 ] || max=5
	now="$(date +%s)"
	cutoff=$((now - window))
	# Keep a bounded record of line fingerprints across repeated logread polls.
	logread -l 200 2>/dev/null | while IFS= read -r line; do
		case "$line" in
			*luci:\ failed\ login*) type=luci ;;
			*dropbear*Bad\ password*|*dropbear*nonexistent\ user*) type=ssh ;;
			*) continue ;;
		esac
		key="$(printf '%s' "$line" | cksum | awk '{print $1}')"
		grep -Fqx "$key" "$STATE/auth-lines" 2>/dev/null && continue
		printf '%s\n' "$key" >> "$STATE/auth-lines"
		printf '%s\n' "$now" >> "$STATE/auth-$type"
	done
	[ -e "$STATE/auth-lines" ] && tail -n 300 "$STATE/auth-lines" > "$STATE/auth-lines.new" &&
		mv -f "$STATE/auth-lines.new" "$STATE/auth-lines"
	for type in ssh luci; do
		[ -f "$STATE/auth-$type" ] || continue
		awk -v cutoff="$cutoff" '$1>cutoff' "$STATE/auth-$type" > "$STATE/auth-$type.new"
		mv -f "$STATE/auth-$type.new" "$STATE/auth-$type"
		count="$(wc -l < "$STATE/auth-$type")"
		[ "$count" -ge "$max" ] || continue
		if [ ! -f "$STATE/auth-$type-alert" ] ||
			[ $((now - $(cat "$STATE/auth-$type-alert"))) -ge "$window" ]; then
			emit "auth.$type.failed" "$count failed $type logins within $window seconds" '' '' "$count" high
			printf '%s' "$now" > "$STATE/auth-$type-alert"
		fi
	done
}

health_poll() {
	local temp='' max_temp load max_load mem min_mem disk min_disk mount
	for file in /sys/class/thermal/thermal_zone*/temp; do
		[ -r "$file" ] || continue
		temp="$(cat "$file" 2>/dev/null)"
		case "$temp" in ''|*[!0-9]*) continue ;; esac
		[ "$temp" -ge 1000 ] && temp=$((temp / 1000))
		break
	done
	max_temp="$(number_or "$(setting cpu_temperature 80)" 80)"
	[ -z "$temp" ] || [ "$temp" -lt "$max_temp" ] ||
		emit health.cpu_temp.high "CPU temperature is $temp°C (threshold $max_temp°C)" '' '' "$temp" high

	load="$(cut -d' ' -f1 /proc/loadavg 2>/dev/null)"
	max_load="$(number_or "$(setting load_threshold 4)" 4)"
	awk -v x="$load" -v limit="$max_load" 'BEGIN { exit !(x+0>=limit+0) }' &&
		emit health.load.high "Load average is $load (threshold $max_load)" '' '' "$load" high

	mem="$(awk '/^MemAvailable:/ {print int($2/1024); exit}' /proc/meminfo 2>/dev/null)"
	min_mem="$(number_or "$(setting memory_available_mb 32)" 32)"
	[ -z "$mem" ] || [ "$mem" -gt "$min_mem" ] ||
		emit health.memory.high "Available memory $mem MiB (threshold $min_mem MiB)" '' '' "$mem" high

	mount="$(setting storage_mount /)"
	case "$mount" in /*) ;; *) mount=/ ;; esac
	disk="$(df -Pk "$mount" 2>/dev/null | awk 'NR==2 {print int($4/1024)}')"
	min_disk="$(number_or "$(setting storage_available_mb 32)" 32)"
	[ -z "$disk" ] || [ "$disk" -gt "$min_disk" ] ||
		emit health.storage.low "Available storage $disk MiB at $mount (threshold $min_disk MiB)" '' '' "$disk" high
}

summary_poll() {
	local uptime load mem mount disk wans ips
	uptime="$(cut -d. -f1 /proc/uptime 2>/dev/null)"
	load="$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)"
	mem="$(awk '/^MemAvailable:/ {print int($2/1024); exit}' /proc/meminfo)"
	mount="$(setting storage_mount /)"
	disk="$(df -Pk "$mount" 2>/dev/null | awk 'NR==2 {print int($4/1024)}')"
	wans="$(setting wan_interfaces 'wan wan6')"
	ips="$(for iface in $wans; do
		printf '%s: IPv4 %s, IPv6 %s, PD %s; ' "$iface" \
			"$(cat "$STATE/wan-$iface-ipv4" 2>/dev/null)" \
			"$(cat "$STATE/wan-$iface-ipv6" 2>/dev/null)" \
			"$(cat "$STATE/wan-$iface-prefix" 2>/dev/null)"
	done)"
	emit system.summary "Uptime: ${uptime}s; load: $load; memory available: ${mem} MiB; storage available: ${disk} MiB; $ips" '' '' '' normal
}

boot_once() {
	local bootid old
	bootid="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
	[ -n "$bootid" ] || bootid="$(cut -d. -f1 /proc/uptime)"
	old="$(cat "$STATE/boot-id" 2>/dev/null)"
	[ "$old" = "$bootid" ] && return
	printf '%s' "$bootid" > "$STATE/boot-id"
	emit system.boot 'Router startup complete' '' '' '' normal
}

poll_once() {
	local now interval last
	mkdir "$STATE/monitor-lock" 2>/dev/null || return
	trap 'rmdir "$STATE/monitor-lock" 2>/dev/null' EXIT INT TERM
	boot_once
	wan_poll
	primary_poll
	unknown_devices_poll
	auth_log_poll
	now="$(date +%s)"
	interval="$(number_or "$(setting known_probe_interval 60)" 60)"
	[ "$interval" -ge 15 ] || interval=60
	last="$(number_or "$(cat "$STATE/last-devices" 2>/dev/null)" 0)"
	if [ $((now - last)) -ge "$interval" ]; then
		known_devices_poll
		printf '%s' "$now" > "$STATE/last-devices"
	fi
	interval="$(number_or "$(setting public_ip_interval 900)" 900)"
	[ "$interval" -ge 60 ] || interval=900
	last="$(number_or "$(cat "$STATE/last-public" 2>/dev/null)" 0)"
	if [ $((now - last)) -ge "$interval" ]; then
		if [ "$(setting public_ip_enabled 1)" = 1 ]; then
			public_ipv4
			public_ipv6
		fi
		printf '%s' "$now" > "$STATE/last-public"
	fi
	health_poll
	interval="$(number_or "$(setting summary_interval 86400)" 86400)"
	[ "$interval" -ge 300 ] || interval=86400
	last="$(number_or "$(cat "$STATE/last-summary" 2>/dev/null)" "$now")"
	[ -e "$STATE/last-summary" ] || printf '%s' "$now" > "$STATE/last-summary"
	if [ $((now - last)) -ge "$interval" ]; then
		summary_poll
		printf '%s' "$now" > "$STATE/last-summary"
	fi
	rmdir "$STATE/monitor-lock" 2>/dev/null || true
	trap - EXIT INT TERM
}

if [ "${1:-}" = once ]; then
	[ "$(setting enabled 0)" = 1 ] && poll_once
	exit 0
fi
while :; do
	if [ "$(setting enabled 0)" = 1 ]; then
		poll_once
		/usr/bin/catos-notify flush >/dev/null 2>&1
	fi
	interval="$(number_or "$(setting monitor_interval 30)" 30)"
	[ "$interval" -ge 10 ] && [ "$interval" -le 600 ] || interval=30
	sleep "$interval"
done
