# CatOS Notify
config settings 'main'
	option enabled '0'
	option router_name 'OpenWrt'
	option monitor_interval '30'
	option public_ip_interval '900'
	option public_ip_enabled '1'
	option summary_interval '86400'
	option queue_limit '64'
	option request_timeout '12'
	option retry_limit '3'
	option wan_interfaces 'wan wan6'
	option discover_devices '1'
	option device_interface 'br-lan'
	option known_probe_interval '60'
	option auth_failures '5'
	option auth_window '600'
	option cpu_temperature '80'
	option load_threshold '4'
	option memory_available_mb '32'
	option storage_available_mb '32'
	option storage_mount '/'
	option receiver_enabled '0'
	option receiver_scope 'lan'
	option receiver_auth '1'
	option receiver_token ''
	option receiver_rate_limit '30'

# Additional providers can be added in LuCI as channel sections.
# config channel 'phone'
#	option enabled '1'
#	option name 'Phone'
#	option type 'bark'
#	option url 'https://api.day.app'
#	option key 'YOUR_DEVICE_KEY'

# Delivery groups are created separately and explicitly select member channels:
# config group 'phones'
#	option name 'Phones'
#	list channels 'phone'
# Rules can deliver to multiple channels/groups, with no implicit target:
#	list targets 'channel:phone'
#	list targets 'group:phones'
# Each rule owns its title/body template. No separate template registry exists.

config rule 'wan_down'
	option enabled '1'
	option event 'wan.down'
	option title '{{router}} · WAN disconnected'
	option body 'WAN interface: {{interface}}. {{body}} ({{time}})'
	option cooldown '120'

config rule 'wan_up'
	option enabled '1'
	option event 'wan.up'
	option title '{{router}} · WAN restored'
	option body 'WAN interface: {{interface}}. {{body}} ({{time}})'
	option cooldown '60'

config rule 'wan_ipv4'
	option enabled '1'
	option event 'wan.ipv4.changed'
	option title '{{router}} · WAN IPv4 changed'
	option body 'Interface: {{interface}}. Old: {{old}}. New: {{new}}. {{time}}'
	option cooldown '60'

config rule 'wan_ipv6'
	option enabled '1'
	option event 'wan.ipv6.changed'
	option title '{{router}} · WAN IPv6 changed'
	option body 'Interface: {{interface}}. Old: {{old}}. New: {{new}}. {{time}}'
	option cooldown '60'

config rule 'wan_prefix'
	option enabled '1'
	option event 'wan.prefix.changed'
	option title '{{router}} · IPv6 prefix changed'
	option body 'Interface: {{interface}}. Old prefix: {{old}}. New prefix: {{new}}. {{time}}'
	option cooldown '60'

config rule 'public_ipv4'
	option enabled '1'
	option event 'public.ipv4.changed'
	option title '{{router}} · Public IPv4 changed'
	option body 'Public IPv4: {{old}} → {{new}}. {{time}}'
	option cooldown '120'

config rule 'public_ipv6'
	option enabled '1'
	option event 'public.ipv6.changed'
	option title '{{router}} · Public IPv6 changed'
	option body 'Public IPv6: {{old}} → {{new}}. {{time}}'
	option cooldown '120'

config rule 'wan_primary'
	option enabled '1'
	option event 'wan.primary.changed'
	option title '{{router}} · Primary WAN changed'
	option body 'Primary interface changed from {{old}} to {{new}}. {{time}}'
	option cooldown '60'

config rule 'unknown_device'
	option enabled '1'
	option event 'device.unknown.online'
	option title '{{router}} · Unknown device detected'
	option body 'Unknown device: {{device}}. {{body}} ({{time}})'
	option cooldown '600'

config rule 'known_online'
	option enabled '1'
	option event 'device.known.online'
	option title '{{router}} · Monitored device online'
	option body 'Device: {{device}}. {{body}} ({{time}})'
	option cooldown '120'

config rule 'known_offline'
	option enabled '1'
	option event 'device.known.offline'
	option title '{{router}} · Monitored device offline'
	option body 'Device: {{device}}. {{body}} ({{time}})'
	option cooldown '120'

config rule 'ssh_failures'
	option enabled '1'
	option event 'auth.ssh.failed'
	option title '{{router}} · SSH login failures'
	option body 'SSH authentication alert: {{body}} ({{time}})'
	option cooldown '600'

config rule 'luci_failures'
	option enabled '1'
	option event 'auth.luci.failed'
	option title '{{router}} · LuCI login failures'
	option body 'LuCI authentication alert: {{body}} ({{time}})'
	option cooldown '600'

config rule 'boot'
	option enabled '1'
	option event 'system.boot'
	option title '{{router}} · System started'
	option body '{{body}} ({{time}})'
	option cooldown '60'

config rule 'reboot'
	option enabled '1'
	option event 'system.reboot'
	option title '{{router}} · Reboot initiated'
	option body '{{body}} ({{time}})'
	option cooldown '60'

config rule 'cpu_temperature'
	option enabled '1'
	option event 'health.cpu_temp.high'
	option title '{{router}} · High CPU temperature'
	option body 'Temperature alert: {{body}} ({{time}})'
	option cooldown '1800'

config rule 'load'
	option enabled '1'
	option event 'health.load.high'
	option title '{{router}} · High system load'
	option body 'Load alert: {{body}} ({{time}})'
	option cooldown '1800'

config rule 'memory'
	option enabled '1'
	option event 'health.memory.high'
	option title '{{router}} · Low available memory'
	option body 'Memory alert: {{body}} ({{time}})'
	option cooldown '1800'

config rule 'storage'
	option enabled '1'
	option event 'health.storage.low'
	option title '{{router}} · Low free storage'
	option body 'Storage alert: {{body}} ({{time}})'
	option cooldown '1800'

config rule 'status_summary'
	option enabled '0'
	option event 'system.summary'
	option title '{{router}} · Status summary'
	option body '{{body}}'
	option cooldown '3600'
