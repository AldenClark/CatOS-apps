#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/catos-notify/monitor
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

shutdown() {
	if [ "$(uci -q get catos_notify.main.enabled)" = 1 ]; then
		# rc.common calls shutdown only during system shutdown, not restart.
		# This is best-effort: the network may already have stopped.
		printf '%s\n' '{"source":"system","event":"system.reboot","title":"Router shutting down","body":"A reboot or shutdown has been initiated","severity":"normal"}' |
			/usr/bin/catos-notify publish >/dev/null 2>&1 || true
		/usr/bin/catos-notify flush >/dev/null 2>&1 || true
	fi
	stop
}

service_triggers() {
	procd_add_reload_trigger catos_notify
}
